<Window x:Class="MultiSessionManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="AI CLI 멀티 세션 매니저" Height="760" Width="1280" MinWidth="720" MinHeight="420"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" Icon="{StaticResource AppIcon}"
        PreviewKeyDown="OnWindowKeyDown">
    <Window.Resources>
        <!-- 목록 항목과 ⋯ 버튼이 같이 쓰는 메뉴 -->
        <ContextMenu x:Key="SessionMenu">
            <MenuItem Header="다시 시작" Click="OnRestart" Icon="&#xE768;" />
            <MenuItem Header="중지" Click="OnStop" Icon="&#xE71A;" />
            <Separator />
            <MenuItem Header="이름 변경" Click="OnRename" Icon="&#xE70F;" InputGestureText="F2" />
            <MenuItem Header="폴더 열기" Click="OnOpenFolder" Icon="&#xE838;" />
            <Separator />
            <MenuItem Header="목록에서 닫기" Click="OnClose" Icon="&#xE711;" InputGestureText="Del" />
        </ContextMenu>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="264" MinWidth="200" MaxWidth="480" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 왼쪽: 세션 목록 -->
        <DockPanel Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid DockPanel.Dock="Top" Margin="16,12,8,6">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="세션" FontSize="13" FontWeight="SemiBold" />
                    <Border Margin="8,0,0,0" Padding="7,1" CornerRadius="8" Background="#2D2D2D" VerticalAlignment="Center">
                        <TextBlock x:Name="SessionCount" Text="0" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" />
                    </Border>
                </StackPanel>
                <Button x:Name="NewButton" Style="{StaticResource IconButton}" HorizontalAlignment="Right" Content="&#xE710;"
                        Click="OnNewSession" ToolTip="새 세션 — 폴더를 골라 Claude Code 를 엽니다 (Ctrl+Shift+T)" AutomationProperties.Name="새 세션" />
            </Grid>

            <!-- 아래: 고른 세션 다루기 · 화면 나누기 -->
            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,8">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="RestartButton" Style="{StaticResource IconButton}" Content="&#xE768;" Click="OnRestart"
                                ToolTip="다시 시작 — 멈춘 세션을 같은 대화로 이어서 띄웁니다" AutomationProperties.Name="다시 시작" />
                        <Button x:Name="StopButton" Style="{StaticResource IconButton}" Content="&#xE71A;" Click="OnStop"
                                ToolTip="중지 — 프로세스만 끝냅니다. 대화 기록은 남습니다" AutomationProperties.Name="중지" />
                        <Button x:Name="RenameButton" Style="{StaticResource IconButton}" Content="&#xE70F;" Click="OnRename"
                                ToolTip="이름 변경 (F2)" AutomationProperties.Name="이름 변경" />
                        <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Content="&#xE711;" Click="OnClose"
                                ToolTip="목록에서 닫기 — Claude 쪽 대화 기록은 지우지 않습니다 (Del)" AutomationProperties.Name="닫기" />
                    </StackPanel>
                    <Border HorizontalAlignment="Right" Background="#252526" CornerRadius="6" Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="Layout1Button" Style="{StaticResource SegmentButton}" CommandParameter="1" Click="OnLayoutButton"
                                    ToolTip="1칸 — 한 세션만 크게 (Ctrl+Alt+1)" AutomationProperties.Name="1칸">
                                <Path Data="M0.5,0.5 H15.5 V11.5 H0.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                            </Button>
                            <Button x:Name="Layout2Button" Style="{StaticResource SegmentButton}" CommandParameter="2" Click="OnLayoutButton"
                                    ToolTip="2칸 — 좌우 둘 (Ctrl+Alt+2)" AutomationProperties.Name="2칸">
                                <Path Data="M0.5,0.5 H15.5 V11.5 H0.5 Z M8,0.5 V11.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                            </Button>
                            <Button x:Name="Layout4Button" Style="{StaticResource SegmentButton}" CommandParameter="4" Click="OnLayoutButton"
                                    ToolTip="4칸 — 둘씩 두 줄 (Ctrl+Alt+4)" AutomationProperties.Name="4칸">
                                <Path Data="M0.5,0.5 H15.5 V11.5 H0.5 Z M8,0.5 V11.5 M0.5,6 H15.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid>
                <ListBox x:Name="SessionList" Background="Transparent" BorderThickness="0" Padding="0,2"
                         ItemContainerStyle="{StaticResource SessionItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnListDoubleClick" KeyDown="OnListKeyDown"
                         PreviewMouseRightButtonDown="OnListRightButtonDown" ContextMenu="{StaticResource SessionMenu}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- 상태 점: 작업 중 파랑 · 입력 대기 초록 · 확인 필요 주황 · 오류 빨강 · 그 밖은 회색 -->
                                <Ellipse x:Name="Dot" Width="8" Height="8" Margin="0,6,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Fill="{StaticResource IdleDotBrush}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding WorkingDirectory}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,1,0,0"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding WorkingDirectory}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock x:Name="State" Text="{Binding StatusText}" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" VerticalAlignment="Center" />
                                        <Border x:Name="Fresh" Margin="6,0,0,0" Padding="6,0,6,1" CornerRadius="7" Background="{StaticResource AccentBrush}" Visibility="Collapsed" VerticalAlignment="Center">
                                            <TextBlock Text="새 결과" FontSize="10" Foreground="White" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <Button x:Name="More" Grid.Column="2" Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="12" VerticalAlignment="Top"
                                        Content="&#xE712;" Click="OnMoreClick" ToolTip="메뉴" AutomationProperties.Name="메뉴" Visibility="Hidden" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="More" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Activity}" Value="Working">
                                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource WorkingBrush}" />
                                    <Setter TargetName="State" Property="Foreground" Value="{StaticResource WorkingBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Activity}" Value="Waiting">
                                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource WaitingBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Activity}" Value="NeedsInput">
                                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource NeedsInputBrush}" />
                                    <Setter TargetName="State" Property="Foreground" Value="{StaticResource NeedsInputBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Activity}" Value="Failed">
                                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource FailedBrush}" />
                                    <Setter TargetName="State" Property="Foreground" Value="{StaticResource FailedBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource FailedBrush}" />
                                    <Setter TargetName="State" Property="Foreground" Value="{StaticResource FailedBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                                    <Setter TargetName="Fresh" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 세션이 하나도 없을 때 -->
                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" Margin="24,0,24,40" Visibility="Collapsed">
                    <TextBlock Text="&#xE756;" FontFamily="{StaticResource IconFont}" FontSize="28" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="아직 세션이 없습니다" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4" />
                    <TextBlock Text="작업할 폴더를 고르면 그 폴더에서 Claude Code 가 열립니다." Foreground="{StaticResource SubtleTextBrush}" FontSize="12"
                               TextWrapping="Wrap" TextAlignment="Center" />
                    <Button Style="{StaticResource PrimaryButton}" Content="폴더 열기" Margin="0,14,0,0" HorizontalAlignment="Center" Click="OnNewSession" />
                </StackPanel>
            </Grid>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}" />

        <wv2:WebView2 x:Name="Web" Grid.Column="2" DefaultBackgroundColor="#181818" />

        <!-- 상태줄: 왼쪽은 보고 있는 세션, 오른쪽은 상태별 세션 수 -->
        <Border Grid.Row="1" Grid.ColumnSpan="3" Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,4">
            <DockPanel>
                <TextBlock x:Name="VersionText" DockPanel.Dock="Right" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="14,0,0,0" VerticalAlignment="Center" />
                <StackPanel x:Name="SummaryPanel" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusBar" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
