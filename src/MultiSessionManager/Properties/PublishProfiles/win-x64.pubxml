<?xml version="1.0" encoding="utf-8"?>
<!--
  배포용 게시 설정: dotnet publish src/MultiSessionManager -p:PublishProfile=win-x64
  .NET 을 함께 묶은 exe 하나로 낸다. 런타임 DLL 수백 개를 따로 읽는 일반 배포보다
  앱 코드가 돌기 시작하는 시점이 빨랐다(측정값은 docs/design/01_기술선정_검토.md 3단계).
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- WPF·WebView2 의 네이티브 DLL 까지 exe 에 넣는다. 처음 실행할 때 한 번 풀어 둔다. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- 패키지에 딸린 API 설명 XML 은 실행에 쓰이지 않는다. -->
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <PublishDir>..\..\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
