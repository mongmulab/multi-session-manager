<Window x:Class="MultiSessionManager.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="세션 이름 변경" Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <StackPanel Margin="20,18,20,16">
        <TextBlock Text="세션 이름" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBox x:Name="NameBox" />
        <TextBlock Text="목록과 칸 머리에 바로 바뀝니다. Claude 입력칸 쪽 이름은 다음에 시작할 때 바뀝니다."
                   Foreground="{StaticResource SubtleTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="취소" IsCancel="True" MinWidth="80" Margin="0,0,8,0" />
            <Button Content="바꾸기" IsDefault="True" MinWidth="80" Style="{StaticResource PrimaryButton}" Click="OnOk" />
        </StackPanel>
    </StackPanel>
</Window>
