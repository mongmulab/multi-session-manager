<Window x:Class="MultiSessionManager.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="세션 이름 변경" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="Malgun Gothic" FontSize="13">
    <StackPanel Margin="14">
        <TextBlock Text="새 이름" Margin="0,0,0,6" />
        <TextBox x:Name="NameBox" Padding="4" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="바꾸기" IsDefault="True" MinWidth="72" Margin="0,0,8,0" Click="OnOk" />
            <Button Content="취소" IsCancel="True" MinWidth="72" />
        </StackPanel>
    </StackPanel>
</Window>
